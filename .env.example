# OpenRouter API key. Get yours at https://openrouter.ai/keys
# Copy this file to `.env` (cp .env.example .env) and paste your key below.
# NEVER put your real key in this file. This file is committed to git; `.env` is not.
# The VITE_ prefix is required so the browser app can read the value.
VITE_OPENROUTER_API_KEY=your_openrouter_key_here

# Model selected when the app opens. Must be one of the IDs in src/services/models.js
VITE_DEFAULT_MODEL=anthropic/claude-sonnet-5.5
